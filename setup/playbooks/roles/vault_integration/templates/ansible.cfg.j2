# Ansible Configuration for Labtomation
# Generated: {{ ansible_date_time.iso8601 }}

[defaults]
# Collections path - required for ansible.posix and other collections
collections_path = ~/.ansible/collections:/usr/share/ansible/collections

# Default inventory - proxmox_nodes.yml is generated during discovery phase
# inventory = inventory/proxmox_nodes.yml
host_key_checking = False
retry_files_enabled = False
gathering = smart
fact_caching = jsonfile
fact_caching_connection = /tmp/ansible_fact_cache
fact_caching_timeout = 3600
stdout_callback = ansible.builtin.default
callbacks_enabled = timer, profile_tasks

[callback_default]
result_format = yaml

# SSH settings
timeout = 30
ssh_args = -o ControlMaster=auto -o ControlPersist=60s

[inventory]
enable_plugins = yaml, ini

[privilege_escalation]
become = True
become_method = sudo
become_user = root
become_ask_pass = False

[ssh_connection]
pipelining = True
control_path = /tmp/ansible-ssh-%%h-%%p-%%r
