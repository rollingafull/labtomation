# Proxmox Nodes Inventory
# Auto-generated by Labtomation on {{ ansible_date_time.iso8601 }}
# Network scanned: {{ network_range }}

proxmox_nodes:
  hosts:
{% for node in proxmox_nodes_discovered %}
    {{ node.hostname }}:
      ansible_host: {{ node.ip }}
      proxmox_version: "{{ node.version }}"
      proxmox_role: "{{ node.role }}"
{% if node.cluster_name != 'none' %}
      cluster_name: "{{ node.cluster_name }}"
{% endif %}
{% endfor %}

  vars:
    # Initial connection as root for bootstrap
    ansible_user: root
    ansible_password: "{{ '{{' }} temp_root_password {{ '}}' }}"
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

    # Will be updated to labtomation user after bootstrap
    # ansible_user: labtomation
    # ansible_ssh_private_key_file: /home/labtomation/.security/.pve_id_ed25519
    # ansible_become: yes
    # ansible_become_method: sudo
